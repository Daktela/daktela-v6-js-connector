{
  "name": "@daktela/daktela-connector",
  "version": "1.3.0",
  "description": "Daktela's JavaScript SDK",
  "keywords": ["daktela", "omnichannel", "contact center", "communication"],
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "index.d.ts",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest --runInBand --testPathIgnorePatterns=integration.test.js",
    "test:coverage": "jest --runInBand --testPathIgnorePatterns=integration.test.js --coverage",
    "test:integration": "jest --runInBand test/integration.test.js",
    "test:types": "tsc --noEmit -p test/types/tsconfig.json"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daktela/daktela-v6-js-connector.git"
  },
  "author": "Martin Sach",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Daktela/daktela-v6-js-connector/issues"
  },
  "homepage": "https://github.com/Daktela/daktela-v6-js-connector#readme",
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  },
  "directories": {
    "test": "test"
  }
}
